<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Bonhomme Shooter - Mode Chill</title>
  <style>
    body { margin:0; padding:0; display:flex; justify-content:center; align-items:center; height:100vh; background:#111; overflow:hidden; }
    canvas { border:4px solid #ffcc00; }
    #ui { position:absolute; top:15px; left:15px; color:white; font-family:Arial; font-size:20px; text-shadow:2px 2px 4px black; z-index:10; }
  </style>
</head>
<body>
  <canvas id="gameCanvas" width="1200" height="600"></canvas>
  <div id="ui">
    J1 Bleu: <span id="score1">0</span> &nbsp; ❤ <span id="lives1">5</span> &nbsp;&nbsp;&nbsp;
    J2 Vert: <span id="score2">0</span> &nbsp; ❤ <span id="lives2">5</span> &nbsp;&nbsp;&nbsp;
    Vague: <span id="wave">1</span>
  </div>

  <script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    const player1 = { x:300, y:420, speed:7, color:"#00aaff", score:0, vy:0, onGround:true, lives:5, alive:true };
    const player2 = { x:400, y:420, speed:7, color:"#00ff88", score:0, vy:0, onGround:true, lives:5, alive:true };

    let bullets = [], enemyBullets = [], enemies = [];
    let wave = 1, frameCount = 0;
    let cameraX = 0;

    const keys = {};
    const GRAVITY = 0.8, JUMP_FORCE = -18;
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playShootSound() {
      const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
      osc.type = 'sawtooth'; osc.frequency.setValueAtTime(800, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
      osc.connect(gain).connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + 0.15);
    }
    function playHitSound() {}
    function playExplosionSound() {}

    function hitPlayer(player, uiId) {
      if (!player.alive) return;
      player.lives--;
      document.getElementById(uiId).textContent = player.lives;
      playHitSound();
      if (player.lives <= 0) {
        player.alive = false;
        if (!player1.alive && !player2.alive) gameOver();
      }
    }

    function drawBackground(camX) {
      const gradient = ctx.createLinearGradient(0, 0, 0, 450);
      gradient.addColorStop(0, "#0a1428"); 
      gradient.addColorStop(1, "#1e3a6e");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, canvas.width, 600);

      // Étoiles
      ctx.fillStyle = "#ffffff";
      for (let i = 0; i < 70; i++) {
        const x = (i * 83 + camX * 0.1) % (canvas.width + 100) - 50;
        const y = 35 + (i % 18) * 26;
        ctx.globalAlpha = 0.7 + Math.sin(frameCount/25 + i) * 0.3;
        ctx.fillRect(x, y, 1.8, 1.8);
      }
      ctx.globalAlpha = 1;

      // Soleil
      const sunX = 320 - camX * 0.08;
      ctx.fillStyle = "#ffdd00"; ctx.beginPath(); ctx.arc(sunX, 120, 48, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = "#ffaa00"; ctx.beginPath(); ctx.arc(sunX, 120, 35, 0, Math.PI*2); ctx.fill();

      // Montagnes
      ctx.fillStyle = "#1e2a4a";
      ctx.beginPath(); ctx.moveTo(-300 - camX*0.4, 450); ctx.lineTo(350 - camX*0.4, 210); ctx.lineTo(950 - camX*0.4, 450); ctx.fill();
      ctx.beginPath(); ctx.moveTo(600 - camX*0.4, 450); ctx.lineTo(1350 - camX*0.4, 190); ctx.lineTo(1900 - camX*0.4, 450); ctx.fill();

      // Sol
      ctx.fillStyle = "#3a2f1e"; ctx.fillRect(0, 450, canvas.width, 150);
      ctx.fillStyle = "#1e5a1e"; ctx.fillRect(0, 445, canvas.width, 12);

      // Lignes route
      ctx.strokeStyle = "#ffcc00"; ctx.lineWidth = 6;
      for (let i = -2; i < 15; i++) {
        const x = (i * 120 - (camX * 0.7) % 120);
        ctx.beginPath(); ctx.moveTo(x, 520); ctx.lineTo(x + 65, 520); ctx.stroke();
      }
    }

    function drawStickman(x, y, color) {
      ctx.strokeStyle = color; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(x+15,y+10); ctx.lineTo(x+15,y+38); ctx.stroke();
      ctx.beginPath(); ctx.arc(x+15,y+8,8,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x+15,y+22); ctx.lineTo(x+4,y+30); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x+15,y+22); ctx.lineTo(x+35,y+22); ctx.lineTo(x+45,y+20); ctx.stroke();
      ctx.strokeStyle = "#333"; ctx.lineWidth = 6; ctx.stroke();
      ctx.strokeStyle = color; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(x+15,y+38); ctx.lineTo(x+8,y+50);
      ctx.moveTo(x+15,y+38); ctx.lineTo(x+22,y+50); ctx.stroke();
    }

    function drawDeadStickman(x, y, color) {
      ctx.globalAlpha = 0.4; drawStickman(x, y, color); ctx.globalAlpha = 1;
      ctx.strokeStyle = "#ff0000"; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(x+5,y+5); ctx.lineTo(x+35,y+55); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x+35,y+5); ctx.lineTo(x+5,y+55); ctx.stroke();
    }

    window.addEventListener("keydown", e => keys[e.key.toLowerCase()] = true);
    window.addEventListener("keyup", e => keys[e.key.toLowerCase()] = false);
    canvas.addEventListener("click", () => { if (player1.alive){ shoot(player1); playShootSound(); }});
    canvas.addEventListener("contextmenu", e => { e.preventDefault(); if (player2.alive){ shoot(player2); playShootSound(); }});

    function shoot(player) {
      bullets.push({x: player.x + 40, y: player.y + 25, vx: 17, vy: 0, radius: 6, owner: player === player1 ? 1 : 2});
    }

    function updatePlayer(player, left, right, jump) {
      if (!player.alive) return;
      if (keys[left]) player.x -= player.speed;
      if (keys[right]) player.x += player.speed;
      if (keys[jump] && player.onGround) { player.vy = JUMP_FORCE; player.onGround = false; }
      player.vy += GRAVITY; player.y += player.vy;
      if (player.y >= 420) { player.y = 420; player.vy = 0; player.onGround = true; }
      player.x = Math.max(100, player.x);
    }

    function updateCamera() {
      const alive = [];
      if (player1.alive) alive.push(player1.x);
      if (player2.alive) alive.push(player2.x);
      if (alive.length === 0) return;
      const avg = alive.reduce((a,b)=>a+b)/alive.length;
      cameraX = Math.max(0, avg - 480);
    }

    function spawnEnemy() {
      const spawnX = cameraX + 1200 + Math.random() * 400;
      enemies.push({
        x: spawnX,
        y: 420,
        shootTimer: 80 + Math.random() * 60,   // très lent
        alive: true
      });
    }

    function gameLoop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      updatePlayer(player1, "arrowleft", "arrowright", "arrowup");
      updatePlayer(player2, "a", "d", "w");
      updateCamera();

      frameCount++;

      if (frameCount % (60 * 35) === 0) {
        wave++;
        document.getElementById("wave").textContent = wave;
      }

      drawBackground(cameraX);

      // Spawn très lent
      if (Math.random() < 0.009 + wave * 0.0025) {
        spawnEnemy();
      }

      // Mise à jour ennemis
      for (let i = enemies.length - 1; i >= 0; i--) {
        let e = enemies[i];
        if (!e.alive) continue;

        const screenX = e.x - cameraX;
        if (screenX < -100) { enemies.splice(i,1); continue; }

        drawStickman(screenX, e.y, "#ff4444");

        e.shootTimer--;
        if (e.shootTimer <= 0) {
          let target = player1.alive ? player1 : player2;
          if (player1.alive && player2.alive) target = player1.x < player2.x ? player1 : player2;

          if (target) {
            const dx = (target.x + 15) - (e.x + 25);
            const dy = (target.y + 25) - (e.y + 25);
            const dist = Math.sqrt(dx*dx + dy*dy) || 1;
            enemyBullets.push({x: e.x+25, y: e.y+25, vx: (dx/dist)*(4.8 + wave*0.2), vy: (dy/dist)*(4.8 + wave*0.2)});
            e.shootTimer = 70 + Math.random()*50;
          }
        }

        // Collision tirs
        for (let j = bullets.length - 1; j >= 0; j--) {
          let b = bullets[j];
          if (b.x > e.x - 8 && b.x < e.x + 42 && b.y > e.y + 5 && b.y < e.y + 55) {
            e.alive = false;
            bullets.splice(j, 1);
            playExplosionSound();
            const points = 30 + wave * 8;
            if (b.owner === 1) player1.score += points;
            else player2.score += points;
            document.getElementById("score1").textContent = player1.score;
            document.getElementById("score2").textContent = player2.score;
            break;
          }
        }
      }

      // Tirs joueurs
      for (let i = bullets.length - 1; i >= 0; i--) {
        let b = bullets[i];
        b.x += b.vx;
        const screenX = b.x - cameraX;
        ctx.fillStyle = "#ffff00";
        ctx.beginPath(); ctx.arc(screenX, b.y, b.radius, 0, Math.PI*2); ctx.fill();
        if (b.x > cameraX + 1500) bullets.splice(i,1);
      }

      // Tirs ennemis
      for (let i = enemyBullets.length - 1; i >= 0; i--) {
        let b = enemyBullets[i];
        b.x += b.vx; b.y += b.vy;
        const screenX = b.x - cameraX;
        ctx.fillStyle = "#ff00ff";
        ctx.beginPath(); ctx.arc(screenX, b.y, 5, 0, Math.PI*2); ctx.fill();

        if (player1.alive && Math.hypot(b.x - player1.x, b.y - (player1.y + 25)) < 28) {
          hitPlayer(player1, "lives1"); enemyBullets.splice(i,1);
        } else if (player2.alive && Math.hypot(b.x - player2.x, b.y - (player2.y + 25)) < 28) {
          hitPlayer(player2, "lives2"); enemyBullets.splice(i,1);
        } else if (b.x < cameraX - 100 || b.x > cameraX + 1600) {
          enemyBullets.splice(i,1);
        }
      }

      if (player1.alive) drawStickman(player1.x - cameraX, player1.y, player1.color);
      else drawDeadStickman(player1.x - cameraX, player1.y, player1.color);
      if (player2.alive) drawStickman(player2.x - cameraX, player2.y, player2.color);
      else drawDeadStickman(player2.x - cameraX, player2.y, player2.color);

      requestAnimationFrame(gameLoop);
    }

    function gameOver() {
      alert("Game Over !\nVague atteinte : " + wave + "\nJ1: " + player1.score + " | J2: " + player2.score);
      location.reload();
    }

    gameLoop();
  </script>
</body>
</html>
