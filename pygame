// --- CONFIGURATION INITIALE & OMBRES ---
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87CEEB); // Bleu ciel éclatant (Sky Blue)
scene.fog = new THREE.FogExp2(0x87CEEB, 0.005); // Brume de chaleur au loin

const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true; // Activer les ombres dans le jeu
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

// --- LUMIÈRES DU SOLEIL (ÉCLARTÉ MAXIMALE) ---
// 1. Lumière ambiante globale (pour éviter les zones toutes noires)
const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
scene.add(ambientLight);

// 2. Le Soleil (Lumière directionnelle forte qui fait des ombres)
const sunLight = new THREE.DirectionalLight(0xfffaed, 1.2); // Couleur chaude du soleil
sunLight.position.set(20, 40, 20); // Placé haut dans le ciel
sunLight.castShadow = true; // Le soleil projette des ombres

